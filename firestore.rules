rules_version = '2';

// Regras do Firestore para o app JRS/HNRe (projeto dedicado jrs-app-web).
// Aplique no console do Firebase (Firestore Database > Regras) ou via
// `firebase deploy --only firestore:rules` (a sessão do Claude Code na nuvem
// tem uma service account dedicada para isso, ver .claude/settings.json).
//
// Coleção "usuarios": id do documento = UID do Firebase Authentication.
// - Qualquer usuário autenticado pode ler a lista (necessário para telas
//   como Perícia Menor/Pareceres que mostram o nome de outros peritos).
// - O admin pode criar/editar/apagar qualquer usuário.
// - Um usuário pode criar o PRÓPRIO documento (fluxo de autocadastro em
//   Login.tsx), desde que não se autoconceda perfil "admin" e já crie a
//   conta ativa.
// - O próprio usuário só pode EDITAR e-mail, Gmail, celular, foto de perfil,
//   a flag de senha temporária e a flag "pwaTutorialConcluido" (tutorial de
//   ícone na tela inicial já concluído) (nunca perfil, nome, NIP, cargo, etc.).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }

    // Médicos: perfis habilitados a gerar Pedidos de Parecer (Admin e user_medicos/_mpi).
    function isMedico() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi'];
    }

    // Equipe da JRS: Admin, médicos (JRS e MPI) e Secretaria — quem registra e agenda as IS
    // e cadastra inspecionados.
    function isEquipe() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria'];
    }
    function isSecretaria() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'user_secretaria';
    }

    match /usuarios/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
         request.resource.data.perfil != 'admin' &&
         request.resource.data.ativo == true);
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['email', 'gmail', 'celular', 'imageProfile', 'senhaTemporaria', 'pwaTutorialConcluido']));
      allow delete: if isAdmin();
    }

    // Coleção "usuarios_publicos": réplica mínima (usuário + status ativo),
    // sem NENHUM dado sensível (sem NIP, e-mail, celular, senha, foto etc.),
    // usada só para popular o menu suspenso de login ANTES da autenticação
    // — mesma exposição que já existia na tela de login anterior (a lista de
    // usuários já era pública ali). Espelhada a partir de "usuarios" sempre
    // que uma conta é criada (Login.tsx / UsuariosManagement.tsx) ou tem o
    // status ativo/inativo alterado.
    match /usuarios_publicos/{uid} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Notificações push: um documento por aparelho (id = token do FCM), com o
    // uid do dono. Cada usuário só grava/apaga os próprios; ninguém lê pelo
    // app — o envio é feito pelo servidor (Admin SDK, ignora estas regras).
    // update aceita trocar o dono: o mesmo aparelho passa ao usuário que logou.
    match /tokens_push/{token} {
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }

    // Histórico das notificações de cada usuário (menu do avatar). Criadas só
    // pelo servidor; o dono lê e só pode marcar como lida.
    match /usuarios/{uid}/notificacoes/{id} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
      allow create, delete: if false;
    }

    // Fila de impressão da Secretaria (Início): documentos enviados por e-mail
    // para a impressão. Qualquer usuário registra em SEU nome (sempre como não
    // aberto); Secretaria e Admin leem e só podem marcar como aberto.
    // Auditoria geral de ações sensíveis (exclusão/geração de documentos): qualquer usuário
    // autenticado grava em SEU nome; só o Admin lê; ninguém edita nem apaga. Sem dados pessoais.
    match /auditoria_acoes/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /documentos_gerados/{id} {
      allow read: if isAdmin() || isSecretaria();
      allow create: if isSignedIn() && request.resource.data.criadoPorUid == request.auth.uid &&
        request.resource.data.aberto == false;
      allow update: if (isAdmin() || isSecretaria()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aberto', 'abertoEm', 'abertoPor']);
      allow delete: if isAdmin();
    }

    // Controle de repetição das notificações: só o servidor usa.
    match /notificacoes_enviadas/{id} {
      allow read, write: if false;
    }

    // Coleção "militares" (página Inspecionados): base de militares da ativa,
    // servidores civis, dependentes e pensionistas (campo "tipo"; migrada da aba
    // "Militares" da planilha). Id do documento = NIP só com dígitos. Qualquer
    // usuário autenticado lê; o Admin cria, edita ou apaga; a equipe (médicos e
    // Secretaria) só CRIA (cadastro rápido a partir do "Novo parecer" e das
    // Inspeções de Saúde) e os médicos podem definir só o Serviço do HNRe
    // ("servico_label", a partir da "Nova perícia menor").
    match /militares/{nip} {
      allow read: if isSignedIn();
      allow create: if isEquipe();
      allow update: if isAdmin() || (isMedico() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['servico_label', 'atualizadoEm']));
      allow delete: if isAdmin();
    }

    // Coleção "periciasMenores": Perícias Menores (um doc por perícia, id
    // automático; liga ao militar por "militarId" = NIP só dígitos; o status
    // Vigente/Concluída é derivado de "dataTermino"). Lê quem está autenticado;
    // só médicos registram; o Admin corrige ou apaga.
    match /periciasMenores/{id} {
      allow read: if isSignedIn();
      allow create: if isMedico();
      allow update, delete: if isAdmin();
    }

    // Coleção "pareceres": Pedidos de Parecer Médico (um doc por pedido, id
    // automático; liga ao militar por "militarId" = NIP só dígitos). Lê quem
    // está autenticado; só médicos criam e atualizam (marcar concluído).
    // Quem não é Admin só pode alterar "status"/"concluidoEm"/"concluidoPor".
    match /pareceres/{id} {
      allow read: if isSignedIn();
      allow create: if isMedico();
      allow update: if isAdmin() || (isMedico() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'concluidoEm', 'concluidoPor']));
      allow delete: if isAdmin();
    }

    // Coleção "inspecoes": Inspeções de Saúde (um doc por IS; id = número da IS,
    // o que garante número único; liga ao inspecionado por "inspecionadoId" = NIP
    // só dígitos). Lê quem está autenticado; a equipe (Admin, médicos e Secretaria)
    // cria e atualiza — o controle fino por funcionalidade está na UI
    // (config/permissions.ts); só o Admin apaga.
    match /inspecoes/{id} {
      allow read: if isSignedIn();
      allow create, update: if isEquipe();
      allow delete: if isAdmin();
    }

    // Coleção "agendaSlots": horário ocupado de um perito ({peritoUid}__{data}T{hh-mm}),
    // gravado na mesma transação do agendamento para impedir dois agendamentos no mesmo horário.
    match /agendaSlots/{id} {
      allow read: if isSignedIn();
      allow write: if isEquipe();
    }

    // Coleção "bloqueiosAgenda": bloqueios de horário/turno da agenda das IS. Admin e
    // Secretaria bloqueiam qualquer perito; um médico a quem o Admin liberou a funcionalidade
    // só bloqueia os PRÓPRIOS horários (peritoUid = seu uid).
    match /bloqueiosAgenda/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isSecretaria() || (isMedico() && request.resource.data.peritoUid == request.auth.uid);
      allow delete: if isAdmin() || isSecretaria() || (isMedico() && resource.data.peritoUid == request.auth.uid);
      allow update: if false;
    }

    // Coleção "legislacao": itens da página Legislação (id = slug da norma;
    // pdfPath aponta o PDF no Storage em legislacao/). Lê quem está autenticado;
    // só o Admin edita.
    match /legislacao/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Coleções "videos" (id = id do vídeo no YouTube) e "infograficos" (imagem no Storage em
    // infograficos/): páginas Vídeos e Infográficos. Lê quem está autenticado; só o Admin edita.
    match /videos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /infograficos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Coleção "apresentacoes": página Apresentações (URL do Google Slides, Canva ou GitHub Pages).
    match /apresentacoes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Coleção "visualizacoesExtras": quem abriu cada vídeo/infográfico/apresentação (id = {tipo}__{itemId}__{uid}).
    // Cada usuário grava só o PRÓPRIO registro (soma 1 em "vezes"); só o Admin lê.
    match /visualizacoesExtras/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.tipo + '__' + request.resource.data.itemId + '__' + request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vezes', 'ultimaEm', 'nome']);
      allow delete: if isAdmin();
    }

    // Coleção "quesitosParecer": modelos de quesitos por especialidade
    // (id = slug da especialidade). Lê quem está autenticado; só o Admin edita.
    match /quesitosParecer/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Coleção "config": documentos de configuração global do app. O único
    // doc hoje é "permissoes" (config/permissoes), a matriz de páginas e
    // funcionalidades por perfil editada em Usuários (Admin) — antes só
    // persistida em localStorage (não compartilhada entre dispositivos).
    // Qualquer usuário autenticado lê (precisa para canAccessPage/
    // canUseFeature funcionarem no próprio dispositivo); só o Admin grava.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Coleção "casos_periciais_resultados": id do documento = UID. Guarda o
    // resultado mais recente do teste "Casos Periciais" (Extras); cada
    // usuário só pode ler/gravar o PRÓPRIO resultado.
    match /casos_periciais_resultados/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // Permissões por funcionalidade (matriz editada pelo Admin em Usuários,
    // documento config/permissoes). As regras leem a MESMA matriz da tela:
    // features[id][perfil], com os padrões de DEFAULT_FEATURE_PERMISSIONS
    // (config/permissions.ts) quando o Admin ainda não mexeu naquela célula.
    // Ao mudar um padrão no código, mude também aqui.
    function perfilAtual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }
    function matrizFeatures() {
      return exists(/databases/$(database)/documents/config/permissoes)
        ? get(/databases/$(database)/documents/config/permissoes).data.get('features', {})
        : {};
    }
    // padroes: { user_medicos, user_secretaria, user_medicos_mpi } → bool.
    function pode(feature, padroes) {
      return isAdmin() || (isSignedIn() &&
        matrizFeatures().get(feature, {}).get(perfilAtual(), padroes.get(perfilAtual(), false)) == true);
    }
    function podeEditarTabela() { return pode('concursosJRS.editarDadosTabela', {'user_medicos': true, 'user_secretaria': false, 'user_medicos_mpi': true}); }
    function podeRegistrarMensagemPDF() { return pode('concursosJRS.registrarMensagemPDF', {'user_medicos': true, 'user_secretaria': false, 'user_medicos_mpi': true}); }
    function podeReagendar() { return pode('concursosJRS.reagendar', {'user_medicos': false, 'user_secretaria': true, 'user_medicos_mpi': false}); }
    function podeImportarCsv() { return pode('concursosJRS.importarCsv', {'user_medicos': false, 'user_secretaria': false, 'user_medicos_mpi': false}); }
    function podeAbrirEncerrar() { return pode('concursosJRS.abrirEncerrarConcurso', {'user_medicos': false, 'user_secretaria': false, 'user_medicos_mpi': false}); }
    function podeArquivarMensagem() { return pode('concursosJRS.registrarMensagemArquivo', {'user_medicos': true, 'user_secretaria': false, 'user_medicos_mpi': true}); }
    function podeAdicionarCandidato() { return pode('concursosJRS.adicionarCandidato', {'user_medicos': true, 'user_secretaria': false, 'user_medicos_mpi': true}); }
    function podeGerarTermoRecurso() { return pode('concursosJRS.gerarTermoRecurso', {'user_medicos': true, 'user_secretaria': false, 'user_medicos_mpi': true}); }
    function podeSolicitar() { return pode('concursosJRS.solicitarParecerExames', {'user_medicos': true, 'user_secretaria': false, 'user_medicos_mpi': true}); }
    function podeEnviarExames() { return pode('concursosJRS.enviarExamesCandidato', {'user_medicos': true, 'user_secretaria': true, 'user_medicos_mpi': true}); }

    // Uma atualização de candidato só pode mexer nos campos da ação que o
    // perfil tem permissão de fazer (cada função de services/firestoreConcursos.ts
    // grava um destes grupos).
    function atualizacaoCandidatoPermitida(alterados) {
      return
        // atualizarCandidato: Status, Observações, Nº TIS e o que deriva deles.
        (podeEditarTabela() && alterados.hasOnly(['status', 'observacoes', 'numTIS', 'dataLaudo', 'laudo', 'finalizado', 'termoCientificacaoUrl', 'termoRecursoUrl', 'recurso'])) ||
        // reagendarCandidato: sempre muda a data e põe o status "Reagendado".
        (podeReagendar() && alterados.hasOnly(['dataAgendamento', 'status', 'finalizado', 'dataLaudo', 'laudo', 'termoCientificacaoUrl', 'termoRecursoUrl', 'recurso'])
          && alterados.hasAll(['dataAgendamento']) && request.resource.data.status == 'Reagendado') ||
        // confirmarAgendamento (criação do concurso pela mensagem)
        ((podeRegistrarMensagemPDF() || podeReagendar()) && alterados.hasOnly(['dataAgendamento'])) ||
        // salvarTermoRecurso
        (podeGerarTermoRecurso() && alterados.hasOnly(['recurso', 'termoRecursoUrl'])) ||
        // salvarTermoCientificacao: qualquer perfil da equipe gera o termo de cientificação.
        (isEquipe() && alterados.hasOnly(['termoCientificacaoUrl'])) ||
        // registrarSolicitacao (Pedido de Parecer / Solicitação de Exames): acrescenta um
        // documento e põe o status "Pendente".
        (podeSolicitar() && alterados.hasOnly(['solicitacoesParecer', 'solicitacoesExames', 'status', 'dataLaudo', 'laudo', 'observacoes', 'finalizado'])
          && alterados.hasAny(['solicitacoesParecer', 'solicitacoesExames']) && request.resource.data.status == 'Pendente') ||
        // salvarExamesCandidato
        (podeEnviarExames() && alterados.hasOnly(['examesQtd', 'examesPdfUrls', 'examesEnviadoEm'])) ||
        // salvarTriagem: só o MPI.
        (isSignedIn() && perfilAtual() == 'user_medicos_mpi' && alterados.hasOnly(['triagem']));
    }

    // Coleção "concursos": backend do menu Concursos ("Planilhas de
    // Controle"), com subcoleções "candidatos", "mensagens" e
    // "agendamentos". Leitura para qualquer usuário autenticado; cada
    // gravação exige a funcionalidade correspondente da matriz de permissões
    // (o Admin pode tudo). Status do concurso: abrirEncerrarConcurso.
    match /concursos/{concursoId} {
      allow read: if isSignedIn();
      allow create: if podeRegistrarMensagemPDF() || podeImportarCsv();
      allow update: if isAdmin() || (
        (podeAbrirEncerrar() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'periodoInicioISO', 'periodoFimISO'])) ||
        ((podeAdicionarCandidato() || podeRegistrarMensagemPDF() || podeImportarCsv()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalCandidatos']))
      );
      allow delete: if isAdmin();

      match /candidatos/{candidatoId} {
        allow read: if isSignedIn();
        allow create: if podeAdicionarCandidato() || podeRegistrarMensagemPDF() || podeImportarCsv();
        allow update: if isAdmin() || atualizacaoCandidatoPermitida(request.resource.data.diff(resource.data).affectedKeys());
        allow delete: if isAdmin();

        // Exames que o candidato entregou: um documento por PDF enviado, com a
        // transcrição dos laudos lida pelo Gemini (ver salvarExamesCandidato em
        // services/firestoreConcursos.ts). Apagados só pelo "Limpar IS" (Admin).
        match /exames/{exameId} {
          allow read: if isSignedIn();
          allow create: if podeEnviarExames();
          allow update, delete: if isAdmin();
        }

        // Registro de eventos (auditoria) da IS: qualquer usuário autenticado
        // grava um evento em SEU nome; só o Admin lê; ninguém edita nem apaga.
        match /eventos/{eventoId} {
          allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
          allow read: if isAdmin();
          allow update, delete: if false;
        }
      }
      match /mensagens/{mensagemId} {
        allow read: if isSignedIn();
        allow create: if podeRegistrarMensagemPDF() || podeArquivarMensagem() || podeImportarCsv();
        allow update, delete: if isAdmin();
      }
      match /agendamentos/{data} {
        allow read: if isSignedIn();
        allow write: if podeRegistrarMensagemPDF() || podeImportarCsv() || podeAbrirEncerrar();
      }
    }
  }
}
