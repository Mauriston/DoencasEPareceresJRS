rules_version = '2';

// Regras do Firebase Storage para as fotos de perfil dos usuários do app
// JRS/HNRe. Projeto dedicado (jrs-app-web) — aplique manualmente no console
// do Firebase (Storage > Regras) ou via `firebase deploy --only storage`,
// pois este ambiente não tem acesso ao Firebase CLI/credenciais do projeto.
//
// Leitura é pública (as fotos aparecem na topbar/sidebar de todos os
// usuários). A escrita exige um usuário autenticado — o login do próprio
// app já é via Firebase Authentication (e-mail/senha), então qualquer
// usuário logado no app satisfaz esta regra.
service firebase.storage {
  match /b/{bucket}/o {
    match /perfil/{usuario}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // PDFs dos Pedidos de Parecer Médico (página Pareceres), gerados pelo Apps
    // Script a partir do template e enviados pelo app (pareceres/{id}.pdf).
    match /pareceres/{arquivo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }

    // PDFs dos atestados das Perícias Menores (periciasMenores/{id}.pdf), gerados
    // no navegador a partir da foto do atestado.
    match /periciasMenores/{arquivo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }

    // PDFs do menu Concursos ("Planilhas de Controle"): cópia da mensagem
    // administrativa original (concursos/{id}/mensagens/...) e o Termo de
    // Cientificação de Recurso de cada candidato
    // (concursos/{id}/termos/{matricula}.pdf), gerado pelo Apps Script
    // standalone mínimo (ver CodeConcursos.gs) e enviado pelo app. Acesso
    // restrito a usuários autenticados, como o restante do app.
    match /concursos/{concursoId}/{arquivo=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      // Apagar: o Termo de Cientificação é removido quando o Status do candidato muda.
      allow delete: if request.auth != null;
    }

    // PDFs da página Legislação (legislacao/{id}.pdf). Leitura autenticada;
    // escrita só do Admin (perfil lido do Firestore), PDF até 25 MB.
    match /legislacao/{arquivo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin'
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if false;
    }

    // Imagens da página Infográficos (infograficos/{id}.{ext}). Leitura autenticada;
    // envio e remoção só do Admin, imagem até 10 MB.
    match /infograficos/{arquivo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }

    // PDFs dos capítulos da DGPM-406 (dgpm406/capitulos/capitulo-NN.pdf),
    // exibidos/baixados na página Normas > DGPM-406. Leitura para usuários
    // autenticados; escrita só pelo script de carga (Admin SDK ignora regras).
    match /dgpm406/{arquivo=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Áudio das entrevistas gravadas da IS (config/entrevistas.ts; ADR-014):
    // entrevistas/{isId}/{entrevistaId}/original.{ext}, enviado pelo celular de um membro da
    // junta (Admin ou user_medicos), áudio até 80 MB. Ninguém lê, troca nem apaga pelo app: o
    // servidor converte (audio.flac), transcreve e devolve o áudio por /api/entrevistas/ouvir
    // (Admin SDK). Apagado 90 dias depois pela regra de ciclo de vida do bucket
    // (scripts/entrevistas/configurar-retencao.sh).
    match /entrevistas/{isId}/{entrevistaId}/{arquivo} {
      allow create: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos']
        && arquivo.matches('original[.].*')
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow read, update, delete: if false;
    }

    // Documentos das férias e afastamentos (página Férias; services/afastamentos.ts): afastamentos/{id}/{arquivo},
    // PDF ou imagem até 15 MB. A equipe da JRS (Admin, médicos JRS/MPI e Secretaria) lê; só o Admin envia e apaga.
    match /afastamentos/{afastamentoId}/{arquivo} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria'];
      allow create: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin'
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
      allow update: if false;
    }

    // Exames da IS (PDFs; services/examesIS.ts): inspecoes/{isId}/exames/{exameId}.pdf. A equipe
    // (Admin, médicos JRS/MPI e Secretaria) lê; envia (PDF até 15 MB) e apaga enquanto a IS não está finalizada.
    match /inspecoes/{isId}/exames/{arquivo} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria'];
      allow create: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria']
        && firestore.get(/databases/(default)/documents/inspecoes/$(isId)).data.situacao != 'finalizada'
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria']
        && firestore.get(/databases/(default)/documents/inspecoes/$(isId)).data.situacao != 'finalizada';
      allow update: if false;
    }
  }
}
