rules_version = '2';

// Regras do Firebase Storage para as fotos de perfil dos usuários do app
// JRS/HNRe. Projeto dedicado (jrs-app-web) — aplique manualmente no console
// do Firebase (Storage > Regras) ou via `firebase deploy --only storage`,
// pois este ambiente não tem acesso ao Firebase CLI/credenciais do projeto.
//
// Leitura é pública (as fotos aparecem na topbar/sidebar de todos os
// usuários). A escrita exige um usuário autenticado — o login do próprio
// app já é via Firebase Authentication (e-mail/senha), então qualquer
// usuário logado no app satisfaz esta regra.
service firebase.storage {
  match /b/{bucket}/o {
    match /perfil/{usuario}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
