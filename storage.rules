rules_version = '2';

// Regras do Firebase Storage para as fotos de perfil dos usuários do app
// JRS/HNRe. Projeto dedicado (jrs-app-web) — aplique manualmente no console
// do Firebase (Storage > Regras) ou via `firebase deploy --only storage`,
// pois este ambiente não tem acesso ao Firebase CLI/credenciais do projeto.
//
// Leitura é pública (as fotos aparecem na topbar/sidebar de todos os
// usuários). A escrita exige um usuário autenticado — o login do próprio
// app já é via Firebase Authentication (e-mail/senha), então qualquer
// usuário logado no app satisfaz esta regra.
service firebase.storage {
  match /b/{bucket}/o {
    match /perfil/{usuario}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // PDFs dos Pedidos de Parecer Médico: pareceres/{id}.pdf (gerado e gravado pelo servidor do app —
    // Admin SDK; os antigos eram enviados pelo app) e a resposta do especialista, pareceres/{id}-resposta.pdf
    // (enviada pelo app na Ficha › Pareceres — services/respostaParecer.ts).
    match /pareceres/{arquivo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }

    // PDFs dos atestados das Perícias Menores (periciasMenores/{id}.pdf), gerados
    // no navegador a partir da foto do atestado.
    match /periciasMenores/{arquivo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }

    // PDFs do menu Concursos ("Planilhas de Controle"). Nos concursos criados a partir de 20/11/2026 os
    // PDFs ficam SÓ aqui (services/driveConcursos.ts; docs/retencao-lgpd.md):
    //   concursos/{id}/mensagens/…, concursos/{id}/candidatos/{matricula}/{TIPO}_{data}.pdf (termos e
    //   solicitações) e concursos/{id}/candidatos/{matricula}/exames/EXAMES_{data}.pdf (até 10 MB — config/limitePdf.ts).
    // Os antigos (concursos/{id}/termos/…) também ficam aqui. Cada envio tem nome único: ninguém troca nem
    // apaga pelo app — mensagens, termos e solicitações nunca são apagados; o PDF dos exames é apagado pelo
    // servidor (Admin SDK) 1 ano depois (servidor/concursos/retencaoExames.ts).
    match /concursos/{concursoId}/{arquivo=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }

    // PDFs da página Legislação (legislacao/{id}.pdf). Leitura autenticada;
    // escrita só do Admin (perfil lido do Firestore), PDF até 10 MB (config/limitePdf.ts).
    match /legislacao/{arquivo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if false;
    }

    // PDFs dos capítulos da DGPM-406 (dgpm406/capitulos/capitulo-NN.pdf),
    // exibidos/baixados na página Normas > DGPM-406. Leitura para usuários
    // autenticados; escrita só pelo script de carga (Admin SDK ignora regras).
    match /dgpm406/{arquivo=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Áudio das entrevistas gravadas da IS (config/entrevistas.ts; ADR-014):
    // entrevistas/{isId}/{entrevistaId}/original.{ext}, enviado pelo celular de um membro da
    // junta (Admin ou user_medicos), áudio até 80 MB. Ninguém lê, troca nem apaga pelo app: o
    // servidor converte (audio.flac), transcreve e devolve o áudio por /api/entrevistas/ouvir
    // (Admin SDK). Apagado 180 dias depois pela regra de ciclo de vida do bucket
    // (scripts/entrevistas/configurar-retencao.sh).
    match /entrevistas/{isId}/{entrevistaId}/{arquivo} {
      allow create: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos']
        && arquivo.matches('original[.].*')
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow read, update, delete: if false;
    }

    // Documentos das férias e afastamentos (página Férias; services/afastamentos.ts): afastamentos/{id}/{arquivo},
    // PDF ou imagem até 10 MB (config/limitePdf.ts). A equipe da JRS (Admin, médicos JRS/MPI e Secretaria) lê; só o Admin envia e apaga.
    match /afastamentos/{afastamentoId}/{arquivo} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria'];
      allow create: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin'
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
      allow update: if false;
    }

    // Exames da IS (PDFs; services/examesIS.ts): inspecoes/{isId}/exames/{exameId}.pdf. A equipe
    // (Admin, médicos JRS/MPI e Secretaria) lê; envia (PDF até 10 MB — config/limitePdf.ts) e apaga enquanto a IS não está finalizada.
    match /inspecoes/{isId}/exames/{arquivo} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria'];
      allow create: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria']
        && firestore.get(/databases/(default)/documents/inspecoes/$(isId)).data.situacao != 'finalizada'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria']
        && firestore.get(/databases/(default)/documents/inspecoes/$(isId)).data.situacao != 'finalizada';
      allow update: if false;
    }

    // Guias de exames da IS (PDF gerado no servidor — servidor/documentos/guiasExames/): inspecoes/{isId}/guias/guias-exames.pdf.
    // A equipe lê; só o servidor grava e apaga (Admin SDK), inclusive 15 dias depois da finalização da IS.
    match /inspecoes/{isId}/guias/{arquivo} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria'];
      allow write: if false;
    }
    // Documentos gerados na IS (Gerar Documento ▾ da Ficha; servidor/documentos/is/): inspecoes/{isId}/documentos/{tipo}-{id}.pdf.
    // PERMANENTES: sem regra de ciclo de vida nem limpeza (só saem ao excluir a IS). Lê a equipe (todos menos
    // user_medicos_geral); só o servidor grava (Admin SDK).
    match /inspecoes/{isId}/documentos/{arquivo} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'user_medicos', 'user_medicos_mpi', 'user_secretaria'];
      allow write: if false;
    }

    // PDFs de TESTE dos documentos da IS (Admin): apagados pelo servidor 30 min depois (limparTestesDocumentosIS).
    match /testes/documentosIS/{arquivo} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
      allow write: if false;
    }
      // Anexos do Chat entre usuários (services/chat.ts): conversas/{a_b}/{msgId}_{nome}. Só os dois
    // participantes (uids no id da conversa) leem; envia quem participa e tem "enviar anexos" em config/chat
    // (padrão liberado), PDF ou imagem JPG/PNG/WEBP até 10 MB (utils/chat.ts). Ninguém troca; o Admin apaga
    // (moderação) e o servidor apaga 7 dias depois do envio (servidor/chat/retencaoAnexos.ts, Admin SDK).
    match /conversas/{conversaId}/{arquivo} {
      allow read: if request.auth != null && request.auth.uid in conversaId.split('_');
      allow create: if request.auth != null
        && request.auth.uid in conversaId.split('_')
        && conversaId.split('_').size() == 2
        && (!firestore.exists(/databases/(default)/documents/config/chat)
            || firestore.get(/databases/(default)/documents/config/chat).data.get('perfis', {})
                 .get(firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil, {})
                 .get('anexos', true) == true)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
      allow update: if false;
    }
  }
}
